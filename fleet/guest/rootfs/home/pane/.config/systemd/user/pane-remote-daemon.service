# The Pane daemon, as Pane's own remote setup writes this unit, but run straight from the AppImage:
# Pane's setup refuses to install its unit from an AppImage (it looks for the mounted copy it runs from).
# Agent panels inherit this environment: find the agent CLIs, resume after a stop, and keep Pane's
# secrets on the secrets volume (K1). Sign-in files the agent CLIs write themselves
# (~/.codex/auth.json, ~/.config/gh/hosts.yml) are not moved there yet and stay on the Session disk.
[Unit]
Description=Pane Remote Daemon

[Service]
Type=simple
Environment=PANE_DIR=/home/pane/.pane
Environment=ELECTRON_OZONE_PLATFORM_HINT=headless
Environment=PATH=/home/pane/.local/bin:/home/pane/.opencode/bin:/usr/local/bin:/usr/bin:/bin
Environment=PANE_RESUME_AGENTS_ON_START=1
Environment=PANE_SECRETS_DIR=/home/pane/.pane-secrets
ExecStart=/home/pane/.local/bin/pane --ozone-platform=headless --disable-gpu --daemon-headless --pane-dir /home/pane/.pane
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
