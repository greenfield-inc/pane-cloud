#!/bin/sh
# The first clone's credential helper (D-107), passed on git's command line by clone.py for the clone
# and its history fetch, so it is never written into .git/config. It answers with the token the one-shot
# unseal left on the secrets volume (never the Session disk, D-58), which goes when the history fetch
# ends; with no file it prints nothing (a public repository, or afterwards, when the Pane daemon's own
# sign-in takes over).
[ "$1" = get ] || exit 0
token_file=/home/pane/.pane-secrets/clone-token
[ -r "$token_file" ] || exit 0
printf 'username=x-access-token\npassword=%s\n' "$(cat "$token_file")"
