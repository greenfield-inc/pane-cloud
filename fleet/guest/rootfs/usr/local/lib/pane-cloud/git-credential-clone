#!/bin/sh
# The first clone's credential helper (D-107), passed on git's command line by clone.py for the clone
# and its backfill, so it is never written into .git/config. It answers with the token the one-shot
# unseal left in /run (tmpfs), which goes when backfill ends; with no file it prints nothing (a public
# repository, or after backfill, when the Pane daemon's own sign-in takes over).
[ "$1" = get ] || exit 0
token_file=/run/pane-cloud/clone-token
[ -r "$token_file" ] || exit 0
printf 'username=x-access-token\npassword=%s\n' "$(cat "$token_file")"
