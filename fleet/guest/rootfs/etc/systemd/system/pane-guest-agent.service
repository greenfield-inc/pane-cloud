[Unit]
Description=Pane Cloud guest agent (vsock port 1024)
# Up right after sysinit, so the host reaches it early and its ready signal goes out the moment the
# Pane daemon listens.
DefaultDependencies=no
After=sysinit.target
Conflicts=shutdown.target
Before=shutdown.target
# Keep restarting however often it crashes: the host needs the agent.
StartLimitIntervalSec=0

[Service]
ExecStart=/usr/bin/python3 -I /usr/local/lib/pane-cloud/pane_guest_agent.py
Restart=always
RestartSec=1s

[Install]
WantedBy=multi-user.target
