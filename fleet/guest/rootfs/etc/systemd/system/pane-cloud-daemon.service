[Unit]
Description=Pane Cloud: run the Pane daemon with workspaces and relay pairing on
Wants=network-online.target user@1000.service
After=network-online.target user@1000.service pane-cloud-firstboot.service pane-cloud-secrets.service

[Service]
Type=oneshot
ExecStart=/usr/local/lib/pane-cloud/pane-daemon.sh
Restart=on-failure
RestartSec=30s

[Install]
WantedBy=multi-user.target
