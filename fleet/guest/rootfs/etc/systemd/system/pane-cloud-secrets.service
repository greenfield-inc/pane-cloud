[Unit]
Description=Pane Cloud: mount the Session's secrets volume, no-exec
DefaultDependencies=no
After=local-fs.target
Before=user@1000.service pane-cloud-daemon.service pane-guest-agent.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/lib/pane-cloud/secrets-volume.sh

[Install]
WantedBy=multi-user.target
