# The one-shot GitHub token unseal at first boot (D-107), the guest agent's code, as root: the host
# sealed the app's token to this slot's key (pane-cloud/ on the secrets volume). It writes K1's drop file
# for the Pane daemon and the clone's token file in /run, then deletes the sealed inputs, before either
# starts. Skipped when nothing is sealed: a public repository, or any later boot.
[Unit]
Description=Pane Cloud: unseal the GitHub token from the create request
DefaultDependencies=no
Requires=pane-cloud-secrets.service
After=pane-cloud-secrets.service
Before=pane-daemon.service pane-cloud-clone.service
ConditionPathExists=/home/pane/.pane-secrets/pane-cloud/github-token.sealed

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -I /usr/local/lib/pane-cloud/pane_guest_agent.py unseal-github-token

[Install]
WantedBy=multi-user.target
