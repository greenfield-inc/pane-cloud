# Pinned guest image inputs. Every download is checked against these SHA-256 sums.

# Root filesystem: Canonical's Ubuntu 24.04 minimal cloud image root tarball.
UBUNTU_RELEASE=20261103
UBUNTU_ROOT_URL=https://cloud-images.ubuntu.com/minimal/releases/noble/release-20261103/ubuntu-24.04-minimal-cloudimg-arm64-root.tar.xz
UBUNTU_ROOT_SHA256=3d0bdf52c95d43794cdb775457250eb96490cc1d2a4bdf65309b57dedc1f966b

# Guest kernel: kernel.org 6.1 LTS built with Firecracker's own 6.1 aarch64 guest config at v1.17.0.
KERNEL_VERSION=6.1.179
KERNEL_SHA256=dd4a164b6ffdcac6b1d958eb14bee256b10819557ee58ac5c9f6a1ae33380126
FIRECRACKER_COMMIT=95f868c8e345b1cc8faccd1a3c910b4989dc3f58
KERNEL_CONFIG_SHA256=5c73202d00b5591ad987d9f808208a318e317fd32dbc17de613c5a93fabe2939
# Built in (=y) or the build fails: vsock, balloon, virtio-rng, ext4, virtio-blk, virtio-net, kernel ip=, tun, nftables.
REQUIRED_KERNEL_CONFIG="VIRTIO_VSOCKETS VIRTIO_BALLOON HW_RANDOM_VIRTIO EXT4_FS VIRTIO_BLK VIRTIO_NET IP_PNP TUN NF_TABLES"

# Node for the agent CLIs that need it (Gemini) and for users' projects.
NODE_VERSION=v22.23.4
NODE_SHA256_arm64=6287aa46b6c375d816e63ae66d024fbbfd70404825aabdfdf898a970871d2f4b

# Tailscale from its official apt repository, at a pinned package version.
TAILSCALE_KEYRING_SHA256=3e03dacf222698c60b8e2f990b809ca1b3e104de127767864284e6c228f1fb39
TAILSCALE_VERSION=1.104.5

# The Pane release baked into the image. Machines update to the release the host names on boot.
PANE_VERSION=2.4.215
PANE_DEB_SHA256=1f1b68c226965e3c69b2814e2a78b01065b0a980323e15e5f6af2c13da1acc42
