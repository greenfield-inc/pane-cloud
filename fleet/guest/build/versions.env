# Pinned guest image inputs. Every download is checked against these SHA-256 sums.
# Per-architecture pins end in the Debian architecture: arm64 is the production image, amd64 exists
# only so CI can boot the image under Firecracker on GitHub's x86_64 KVM runners.

# Root filesystem: Canonical's Ubuntu 24.04 minimal cloud image root tarball.
UBUNTU_RELEASE=20261103
UBUNTU_ROOT_BASE=https://cloud-images.ubuntu.com/minimal/releases/noble/release-20261103
UBUNTU_ROOT_SHA256_arm64=3d0bdf52c95d43794cdb775457250eb96490cc1d2a4bdf65309b57dedc1f966b
UBUNTU_ROOT_SHA256_amd64=e040e84e21745ab9c5ad147f63c1c152eae55d2bf470c6b0d40a50bf9cc12895

# Guest kernel: the one probe P1 booted in Nitro Sandboxes (Firecracker CI's vmlinux-6.18.62), rebuilt
# from kernel.org 6.18.62 with Firecracker's 6.18 guest config and ci.config at the commit that built
# it, plus kernel-hardening.config.
KERNEL_VERSION=6.18.62
KERNEL_SHA256=490a7aedf1b355c565d3a6c05333ccccb5da82064eca46b590448a7099d7d651
FIRECRACKER_COMMIT=6d7cfa9c6b539b2bdd574d4c3b34be4a3c6dffe6
KERNEL_CONFIG_SHA256_arm64=35cce8e8b754a84523ca20dc068fc3f8f03a15523be36a8623bad54e11972e2a
KERNEL_CONFIG_SHA256_amd64=ba22401a0c7292a4c024ebcd10a562d4a1f1bfd2faed671406d3b159c0cf5215
KERNEL_CI_CONFIG_SHA256=a271fc11701c175b16d39f2493873eed527028a846c4da645ac4abc1728699df
# Set to y or the build fails: the devices and features the fleet relies on, lockdown and module signing.
REQUIRED_KERNEL_CONFIG="VIRTIO_VSOCKETS VIRTIO_BALLOON EXT4_FS VIRTIO_BLK VIRTIO_NET IP_PNP TUN NF_TABLES PSI USER_NS
  SECURITY_LOCKDOWN_LSM SECURITY_LOCKDOWN_LSM_EARLY LOCK_DOWN_KERNEL_FORCE_INTEGRITY MODULE_SIG MODULE_SIG_FORCE"
# Absent or the build fails: no entropy device from the host, memory stalls measured from boot, and
# no vsock loopback (which would let guest processes reach the root guest agent).
FORBIDDEN_KERNEL_CONFIG="HW_RANDOM_VIRTIO PSI_DEFAULT_DISABLED VSOCKETS_LOOPBACK"

# Node for the agent CLIs that need it (Gemini) and for users' projects.
NODE_VERSION=v22.23.4
NODE_SHA256_arm64=6287aa46b6c375d816e63ae66d024fbbfd70404825aabdfdf898a970871d2f4b
NODE_SHA256_amd64=1805bcd35e6815559bd2eb97db438d3fdb0eb3a5e6a977b7c1badca76337e9ce

# The Pane release baked into the image, as the release AppImage (SHA256SUMS.txt). Machines update to the
# release the host names on boot, and with Update Pane like any other machine.
PANE_VERSION=2.4.248
PANE_APPIMAGE_SHA256_arm64=895d02fa6d90d12517345afd34839b33f4e09a99abead77b8d8d5f527900b402
PANE_APPIMAGE_SHA256_amd64=dcacdff5eb86c8ee03ef94b322e9df41a061f5d4720f754a087ade343f5beaad

# CI's boot check only: the Firecracker release N1 runs, for x86_64.
FIRECRACKER_VERSION=v1.18.0
FIRECRACKER_SHA256_amd64=1ac8eec866dd5eea14efecf6323e22b23eea24054545338a5b34bc5bca6623cd
