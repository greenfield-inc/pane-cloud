#!/bin/sh
# Fake tailscale: logs calls; `status --json` reports FAKE_AUTH_URL after the first poll.
echo "tailscale $*" >> /out/calls.log
case "$1" in
  status)
    n=$(cat /out/polls 2>/dev/null || echo 0); echo $((n + 1)) > /out/polls
    if [ "$n" -ge 1 ]; then printf '{"BackendState":"NeedsLogin","AuthURL":"%s"}\n' "$FAKE_AUTH_URL"
    else printf '{"BackendState":"NeedsLogin","AuthURL":""}\n'; fi
    exit 1 ;;
esac
