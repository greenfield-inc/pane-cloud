{
  "name": "pane-cloud-service",
  "version": "0.1.0",
  "private": true,
  "description": "The Pane Cloud service: sign-in, teams and seats, the machine lifecycle and the per-machine action log",
  "license": "AGPL-3.0",
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || ^26.12.1"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
